APP_NAME=checkinHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hotelio
DB_USERNAME=root
DB_PASSWORD=root
# Mode SQL strict. Laisser vide/true en dev & CI.
# En prod MySQL 8 (app legacy), mettre false pour éviter les erreurs "field has no default value".
DB_STRICT=true

BROADCAST_DRIVER=pusher

# En CI / local, on évite tout envoi SMTP réel (logs uniquement).
# Passez à "smtp" en production avec vos identifiants.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@myhotel.test"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

APP_TIMEZONE=Africa/Lagos

# FedaPay, paiement des abonnements (sandbox par défaut).
# FEDAPAY_ENV=sandbox puis "live" en production ; renseignez vos clés API FedaPay.
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET=
FEDAPAY_PUBLIC=

# Groq, assistant IA de la vitrine (clé sur https://console.groq.com).
# Vide => l'assistant n'apparaît pas. Modèle par défaut : llama-3.3-70b-versatile.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
